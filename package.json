{
  "name": "@darl/ui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Reusable React UI components built on shadcn/ui patterns, starting with FileUploader.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    },
    "./styles.css": "./dist/lib/darl-ui.css"
  },
  "files": [
    "dist/lib",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:lib && npm run build:demo && npm run build:agent-chat",
    "build:lib": "vite build --config vite.lib.config.ts && tsc --project tsconfig.build.json",
    "build:demo": "vite build --config vite.playground.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:local": "npm run build:lib && npm pack",
    "dev:playground": "vite --config vite.playground.config.ts",
    "dev:agent-chat": "vite --config vite.agent-chat.config.ts",
    "build:agent-chat": "vite build --config vite.agent-chat.config.ts"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.94",
    "@ai-sdk/openai-compatible": "^3.0.69",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ai": "^7.0.141",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-popover": "^1.3.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "fflate": "^0.8.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "license": "MIT"
}
