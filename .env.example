# Server only. Never use a VITE_ prefix for credentials.
AGENT_CHAT_BASE_URL=https://api.darl.cn/v1
AGENT_CHAT_API_KEY=
AGENT_CHAT_MODEL=deepseek-v4.1-flash

# Fish Audio, server only. Also configurable under Settings → Voice.
FISH_API_KEY=
# Optional fixed ports for isolated worktrees. Occupied ports fail instead of switching.
AGENT_CHAT_PORT=5197
PLAYGROUND_PORT=5188
# Comma-separated extra Host headers allowed by the agent-chat dev server (e.g. a Cloudflare Tunnel hostname).
AGENT_CHAT_ALLOWED_HOSTS=
# Preview port for the packaged agent-chat build, used when exposing it through a tunnel or reverse proxy.
AGENT_CHAT_PREVIEW_PORT=5199
# Public hostname and launchd service for this worktree's preview and post-commit hook.
AGENT_CHAT_PUBLIC_HOST=agents.darlai.cn
AGENT_CHAT_PREVIEW_SERVICE=cn.darlai.agents-preview

# Business file storage. Credentials are server-only; never use a VITE_ prefix.
# local (default) or cos. Switching only affects new files; old metadata keeps its backend.
STORAGE_MODE=local
LOCAL_STORAGE_ROOT=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_SCHEME=https
COS_PUBLIC_BASE_URL=
COS_OBJECT_PREFIX=darl-ui
# COS CORS must allow GET and HEAD from the browser origin.
