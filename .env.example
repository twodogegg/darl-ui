# Server only. Never use a VITE_ prefix for credentials.
AGENT_CHAT_BASE_URL=https://api.darl.cn/v1
AGENT_CHAT_API_KEY=
AGENT_CHAT_MODEL=deepseek-v4.1-flash

# Business file storage. Credentials are server-only; never use a VITE_ prefix.
# local (default) or cos. Switching only affects new files; old metadata keeps its backend.
STORAGE_MODE=local
LOCAL_STORAGE_ROOT=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_SCHEME=https
COS_PUBLIC_BASE_URL=
COS_OBJECT_PREFIX=darl-ui
# COS CORS must allow GET and HEAD from the browser origin.
